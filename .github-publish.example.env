# Copie este arquivo para .github-publish.env e preencha os valores.
# Nunca commite o .github-publish.env.

# Token do GitHub com permissão para criar repos e fazer push.
GITHUB_TOKEN=coloque_seu_token_aqui

# Opcional: define um destino fixo.
# GITHUB_OWNER=seu-usuario-ou-organizacao
# GITHUB_REPO=nome-do-repositorio
# GITHUB_VISIBILITY=public
# GITHUB_BRANCH=main
# GITHUB_CREATE_REPO=1
# GITHUB_REMOTE=origin
# GITHUB_DESCRIPTION=Descricao do projeto
# GIT_COMMIT_MESSAGE=chore: initial commit
